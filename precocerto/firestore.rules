rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.papel == 'admin';
    }

    // ============================================
    // USER PROFILE PRIVACY & SECURITY (Fase 14)
    // ============================================
    match /users/{userId} {
      // Ler: Próprio utilizador OU Admin
      allow read: if request.auth != null && (
        request.auth.uid == userId ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.papel == 'admin'
      );

      // Escrever: Próprio utilizador (perfil pessoal) OU Admin
      allow write: if request.auth != null && (
        request.auth.uid == userId ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.papel == 'admin'
      );
    }

    // ============================================
    // STORES & CATEGORIES (Multi-Store System)
    // ============================================
    match /stores/{storeId} {
      allow read: if request.auth != null;
      allow create, update, delete: if isAdmin();
    }

    // Subcoleções de uma loja (categorias, estatísticas, etc.).
    // Sem esta regra, a leitura das categorias era recusada e a vista
    // "Categorias" ficava presa a carregar indefinidamente.
    match /stores/{storeId}/{document=**} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }

    // ============================================
    // AUDITORIA E FEED DE ATIVIDADE
    // ============================================
    match /audit_logs/{logId} {
      // Registos de auditoria são criados pela própria aplicação em nome do
      // utilizador autenticado e nunca são alterados nem apagados.
      allow create: if request.auth != null && (
        !('userId' in request.resource.data) ||
        request.resource.data.userId == request.auth.uid
      );
      allow read: if request.auth != null && (
        resource.data.userId == request.auth.uid || isAdmin()
      );
      allow update, delete: if false;
    }

    match /activity_stream/{activityId} {
      allow create: if request.auth != null && (
        !('userId' in request.resource.data) ||
        request.resource.data.userId == request.auth.uid
      );
      allow read: if request.auth != null;
      allow update, delete: if isAdmin();
    }

    // ============================================
    // LEGACY RULES (Product Management)
    // ============================================
    match /products/{productId} {
      allow read, update, delete: if request.auth != null && resource.data.userId == request.auth.uid;
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
    }

    match /businessSettings/{settingId} {
      allow read, update, delete: if request.auth != null && resource.data.userId == request.auth.uid;
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
    }

    match /priceHistory/{historyId} {
      allow read, update, delete: if request.auth != null && resource.data.userId == request.auth.uid;
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
    }

    match /backupLogs/{logId} {
      allow read, update, delete: if request.auth != null && resource.data.userId == request.auth.uid;
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
    }

    // Default-deny catch-all rule as a global safety net (DEVE ESTAR NO FINAL)
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
