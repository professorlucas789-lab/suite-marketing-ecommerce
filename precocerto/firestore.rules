rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ============================================
    // USER PROFILE PRIVACY & SECURITY (Fase 14)
    // ============================================
    match /users/{userId} {
      // Ler: Próprio utilizador OU Admin
      allow read: if request.auth != null && (
        request.auth.uid == userId ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.papel == 'admin'
      );

      // CRIAR: Apenas Admin pode criar novo utilizador
      allow create: if request.auth != null &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.papel == 'admin';

      // ATUALIZAR: Com proteção de campos sensíveis
      allow update: if request.auth != null && (
        // Caso 1: Admin consegue alterar qualquer campo
        (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.papel == 'admin') ||
        // Caso 2: Utilizador consegue alterar apenas campos de perfil pessoal (nome)
        (request.auth.uid == userId &&
         // Verificar que APENAS campos seguros são modificados
         request.resource.data.diff(resource.data).affectedKeys()
           .hasOnly(['nome', 'dataAtualizacao']) &&
         // Impedir escalação de privilégio (não alterar papel)
         request.resource.data.papel == resource.data.papel &&
         // Impedir auto-atribuição de lojas
         request.resource.data.lojas == resource.data.lojas &&
         // Impedir alterar status ativo
         request.resource.data.ativo == resource.data.ativo
        )
      );

      // ELIMINAR: Apenas Admin
      allow delete: if request.auth != null &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.papel == 'admin';
    }

    // ============================================
    // STORES & CATEGORIES (Multi-Store System)
    // ============================================
    match /stores/{storeId} {
      allow read: if request.auth != null &&
        storeId in get(/databases/$(database)/documents/users/$(request.auth.uid)).data.lojas;
      allow create, update, delete: if request.auth != null &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.papel == 'admin';
    }

    match /stores/{storeId}/categories/{categoryId} {
      allow read: if request.auth != null &&
        storeId in get(/databases/$(database)/documents/users/$(request.auth.uid)).data.lojas;
      allow create, update, delete: if request.auth != null &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.papel == 'admin';
    }

    // ============================================
    // SALES MODULE (Phase 3 & 6)
    // ============================================
    match /stores/{storeId}/sales/{saleId} {
      // Ler: Utilizador autenticado que tem acesso ao storeId pode ver vendas
      allow read: if request.auth != null &&
        storeId in get(/databases/$(database)/documents/users/$(request.auth.uid)).data.lojas;

      // Criar: Utilizador autenticado pode registar vendas
      // - Deve incluir userId válido (seu próprio ID)
      // - Deve incluir storeId que corresponde à loja
      // - Deve ter acesso a esse storeId
      allow create: if request.auth != null &&
        request.resource.data.userId == request.auth.uid &&
        request.resource.data.storeId == storeId &&
        storeId in get(/databases/$(database)/documents/users/$(request.auth.uid)).data.lojas;

      // Actualizar: Apenas o próprio utilizador ou admin pode editar
      // E deve ter acesso ao storeId
      allow update: if request.auth != null &&
        storeId in get(/databases/$(database)/documents/users/$(request.auth.uid)).data.lojas &&
        (resource.data.userId == request.auth.uid ||
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.papel == 'admin');

      // Apagar: Apenas admin pode apagar vendas
      allow delete: if request.auth != null &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.papel == 'admin';
    }

    // ============================================
    // LEGACY RULES (Product Management)
    // ============================================
    match /products/{productId} {
      // READ: Membro da store consegue ler produtos (userId = auditoria)
      allow read: if request.auth != null &&
        resource.data.storeId in get(/databases/$(database)/documents/users/$(request.auth.uid)).data.lojas;

      // CREATE: Membro da store consegue criar produtos
      allow create: if request.auth != null &&
        request.resource.data.userId == request.auth.uid &&
        request.resource.data.storeId in get(/databases/$(database)/documents/users/$(request.auth.uid)).data.lojas;

      // UPDATE: Apenas admin ou manager conseguem editar (RBAC)
      // Proteger imutabilidade de userId e storeId (impedir tenant switch)
      allow update: if request.auth != null &&
        request.resource.data.userId == resource.data.userId &&
        request.resource.data.storeId == resource.data.storeId &&
        resource.data.storeId in get(/databases/$(database)/documents/users/$(request.auth.uid)).data.lojas &&
        (
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.papel == 'admin' ||
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.papel == 'loja-manager'
        );

      // DELETE: Apenas admin consegue eliminar
      allow delete: if request.auth != null &&
        resource.data.storeId in get(/databases/$(database)/documents/users/$(request.auth.uid)).data.lojas &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.papel == 'admin';
    }

    match /businessSettings/{settingId} {
      allow read, update, delete: if request.auth != null &&
        resource.data.userId == request.auth.uid &&
        (resource.data.storeId == null || resource.data.storeId in get(/databases/$(database)/documents/users/$(request.auth.uid)).data.lojas);
      allow create: if request.auth != null &&
        request.resource.data.userId == request.auth.uid &&
        (request.resource.data.storeId == null || request.resource.data.storeId in get(/databases/$(database)/documents/users/$(request.auth.uid)).data.lojas);
    }

    match /priceHistory/{historyId} {
      allow read, update, delete: if request.auth != null && resource.data.userId == request.auth.uid;
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
    }

    match /backupLogs/{logId} {
      allow read, update, delete: if request.auth != null && resource.data.userId == request.auth.uid;
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
    }

    // Default-deny catch-all rule as a global safety net (DEVE ESTAR NO FINAL)
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
