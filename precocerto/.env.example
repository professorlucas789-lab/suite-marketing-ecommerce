# ---------------------------------------------------------------------------
# Firebase Web (client) configuration — OPTIONAL
# ---------------------------------------------------------------------------
# These values are public by design: the Firebase browser SDK sends them with
# every request. They identify the project; they do not grant access. Data
# access is enforced by firestore.rules and Firebase Auth.
#
# The production values are compiled in as defaults (see src/firebase.ts), so
# these variables only need to be set when pointing a build at a different
# Firebase project (e.g. staging).
# VITE_FIREBASE_API_KEY=""
# VITE_FIREBASE_AUTH_DOMAIN=""
# VITE_FIREBASE_PROJECT_ID=""
# VITE_FIREBASE_STORAGE_BUCKET=""
# VITE_FIREBASE_MESSAGING_SENDER_ID=""
# VITE_FIREBASE_APP_ID=""
# VITE_FIREBASE_MEASUREMENT_ID=""

# ---------------------------------------------------------------------------
# Legacy AI Studio variables — NOT used by this app
# ---------------------------------------------------------------------------
# GEMINI_API_KEY and APP_URL were injected automatically by AI Studio. No code
# in this repository reads them, and they must never be exposed to the client:
# a Gemini key belongs in server-side code (a Netlify Function) only. If they
# are still configured on the deploy environment, they can be removed.
