{
  "entities": {
    "Product": {
      "title": "Product",
      "description": "Products with full pricing, packaging and module-specific fields",
      "type": "object",
      "properties": {
        "nome": { "type": "string" },
        "categoria": { "type": "string" },
        "fornecedor": { "type": "string" },
        "custoCompra": { "type": "number" },
        "margemDesejada": { "type": "number" },
        "precoVendaRecomendado": { "type": "number" },
        "lucroEstimado": { "type": "number" },
        "margemReal": { "type": "number" },
        "userId": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["nome", "categoria", "custoCompra", "margemDesejada", "userId"]
    },
    "BusinessSettings": {
      "title": "BusinessSettings",
      "description": "Business configuration and visual preferences",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "companyName": { "type": "string" },
        "businessType": { "type": "string" },
        "currency": { "type": "string" },
        "country": { "type": "string" },
        "language": { "type": "string" },
        "primaryColor": { "type": "string" },
        "dateFormat": { "type": "string" },
        "numberFormat": { "type": "string" },
        "customCategories": {
          "type": "array",
          "items": { "type": "string" }
        }
      },
      "required": ["userId", "companyName", "businessType"]
    },
    "PriceHistory": {
      "title": "PriceHistory",
      "description": "Historic price and margin adjustments",
      "type": "object",
      "properties": {
        "productId": { "type": "string" },
        "productName": { "type": "string" },
        "productCategory": { "type": "string" },
        "userId": { "type": "string" },
        "previousPrice": { "type": "number" },
        "newPrice": { "type": "number" },
        "previousCost": { "type": "number" },
        "newCost": { "type": "number" },
        "previousMargin": { "type": "number" },
        "newMargin": { "type": "number" },
        "changeReason": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["productId", "userId", "previousPrice", "newPrice", "createdAt"]
    },
    "BackupLog": {
      "title": "BackupLog",
      "description": "Audit trail for backup exports, imports and restores",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "type": { "type": "string", "enum": ["export", "import", "restore"] },
        "format": { "type": "string", "enum": ["json", "csv"] },
        "status": { "type": "string", "enum": ["success", "failed"] },
        "totalRecords": { "type": "number" },
        "successfulRecords": { "type": "number" },
        "failedRecords": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" },
        "message": { "type": "string" }
      },
      "required": ["userId", "type", "format", "status", "createdAt"]
    }
  },
  "firestore": {
    "/products/{productId}": {
      "schema": "Product",
      "description": "User specific product portfolio"
    },
    "/businessSettings/{settingId}": {
      "schema": "BusinessSettings",
      "description": "Business parameters and custom categories"
    },
    "/priceHistory/{historyId}": {
      "schema": "PriceHistory",
      "description": "Changes in pricing audit trial"
    },
    "/backupLogs/{logId}": {
      "schema": "BackupLog",
      "description": "Logs tracking data import, export and restorations"
    }
  }
}
