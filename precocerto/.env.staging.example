# ============================================================
# FIREBASE STAGING CONFIGURATION
# ============================================================
# Copiar este ficheiro para .env.staging e preencher com
# as credenciais REAIS do projeto Firebase STAGING

# IMPORTANTE: NUNCA commitar o .env.staging com credenciais reais!

# Ambiente: staging (obrigatório para o script de migração)
VITE_APP_ENV=staging

# Firebase Project Configuration (STAGING)
# Obtém estes valores em: Firebase Console > Project Settings > Web App
VITE_FIREBASE_API_KEY=seu_api_key_staging_aqui
VITE_FIREBASE_AUTH_DOMAIN=seu_project_staging.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=seu-project-id-staging
VITE_FIREBASE_STORAGE_BUCKET=seu-project-staging.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=seu_sender_id_staging
VITE_FIREBASE_APP_ID=seu_app_id_staging
VITE_FIREBASE_MEASUREMENT_ID=seu_measurement_id_staging

# ============================================================
# APPLICATION CONFIGURATION
# ============================================================

GEMINI_API_KEY=

# APP_URL: URL da aplicação em staging
APP_URL=https://precocerto-staging.example.com

# ============================================================
# VITE BUILD CONFIGURATION
# ============================================================

VITE_DEPLOY_TARGET=staging
VITE_PRODUCTION_URL=https://precocerto-staging.example.com
